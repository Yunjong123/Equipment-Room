{
    "name": "equipment-room",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "script": {
        "dev": "concurrently -k -n api, web \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
        "build": "npm run typecheck && vite build --config web/vite.config.ts && node scripts/build.mjs",
        "start": "node dist/server.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node scripts/test-unit.mjs",
        "test:auth": "nopde --experimental-strip-types --test test/auth/session.test.mjs",
        "test:api": "tsx --test --test-concurrency=1 test/api/application.test.ts",
        "test:e2e": "playwright test",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:seed": "tsx scripts/seed.ts",
        "cleanup": "tsx scripts/cleanup.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm test && npm run test: auth && npm run test:api && npm run build",
        "account:create": "tsx scripts/create-account.ts",
        "db:migrate:prod": "node dist/migrate.mjs",
        "account:create:prod": "node dist/create-account.mjs",
        "cleanup:prod": "node dist/cleanup.mjs" 
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.3.14",
        "@tanstack/react-query": "^5.90.2",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "express-session": "^1.18.2",
        "helmet": "^8.1.0",
        "multer": "^2.0.2",
        "pg": "^8.16.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.9.3",
        "sharp": "^0.34.4",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@types/express": "^5.0.3",
        "@types/express-session": "^1.18.2",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.18.6",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.1.16",
        "@types/react-dom": "^19.1.16",
        "@types/supertest": "^6.0.3",
        "@vitejs/plugin-react": "^5.0.4",
        "concurrently": "^9.2.1",
        "esbuild": "^0.25.10",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vite": "^7.1.7"
    }
}