# Defaults work locally without a database server.
NODE_ENV=development
PORT=3001
WEB_PORT=5173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
CLUB_NAME=Northside Media Club
CLUB_TIME_ZONE=America/New_York
DEMO_MODE=true
ALLOW_SIGNUP=true
DATA_DIR=.data
# Set this to use a PostgreSQL server instead of local PGlite.
# DATABASE_URL=postgresql://equipment:equipment@localhost:5432/equipment_room
# DB_SSL=false
# DB_SSL_CA_FILE=/absolute/path/to/ca.pem
# Production requires a random secret of at least 32 characters.
# SESSION_SECRET=
# Set to 1 only behind a trusted, single reverse proxy.
TRUST_PROXY_HOPS=0
