{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "mokduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client"]
    },
    "include": ["server", "web", "shared", "scripts/*.ts", "tests/api", "tests/e2e", "playwright.config.ts"]
}